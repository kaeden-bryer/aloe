# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=8787
DATABASE_PATH=./aloe.db
# Shared secret the demo agents use to pair with the server (see apps/agent).
ALOE_DEMO_PAIRING_CODE=aloe-demo
# How long an idle agent waits before asking for work again (ms). Short for the demo.
ALOE_IDLE_RETRY_MS=5000

# Steward (server-side) uses the Claude API with an API key from the Claude Console.
ANTHROPIC_API_KEY=

# GitHub: a fine-grained personal access token scoped to your demo fork only.
GITHUB_TOKEN=
GITHUB_DEMO_REPO=your-github-user/your-demo-fork

# Weekly email (optional for the demo)
RESEND_API_KEY=

# --- Agent (runs on a donor's machine) ---
ALOE_SERVER_URL=http://localhost:8787
# fake = canned patches, no model calls (use this first)
# claude-sdk = Claude Agent SDK inside Docker
ALOE_AGENT_PROVIDER=fake
# How long the fake provider "works" on each task (ms).
ALOE_FAKE_DELAY_MS=4000

# Demo sign-in picker ("Sign in as ..." personas) and POST /api/demo/reset. 1 = on, anything else = those routes 404.
# Leave OFF in any shared or deployed environment: it lets anyone sign in as anyone.
ALOE_DEMO_LOGIN=1

# Staging publish (Phase 4): on merge, apply the patch to an aloe/staging branch on the project fork and open/update one PR.
# Off by default. Needs BOTH of these. GITHUB_TOKEN (above) must be able to push to the fork and open PRs there.
ALOE_PUBLISH_STAGING=0
# Where the server keeps its git clones (default: <os tmp>/aloe-git-cache).
ALOE_GIT_CACHE=
# Identity on the commits Aloe makes.
ALOE_GIT_AUTHOR_NAME=Aloe Steward
ALOE_GIT_AUTHOR_EMAIL=aloe@users.noreply.github.com
# Demo: PR base branch. aloe/staging starts from it and the PR targets it, so a live merge never lands on the fork's trunk.
# Create it once on the fork (or let "Reset demo + GitHub" create it). Empty = the repo default branch.
ALOE_STAGING_BASE=
# "Reset demo + GitHub" force-sets aloe/demo-base and aloe/staging to this commit (default: the one docker/sandbox-ccf is built from).
# It only ever acts on GITHUB_DEMO_REPO and only on refs starting with aloe/.
ALOE_DEMO_BASE_COMMIT=
# Donor agent: ceiling on model turns per run (a task's spec.maxTurns can only lower it). Default 30.
ALOE_MAX_TURNS=
